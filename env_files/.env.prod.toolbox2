# Environment
ENVIRONMENT=prod
# Data storage - UNIFIED STRUCTURE
DATA_ROOT=/data/ias_prod/data
# Web port
TOOLS_WEB_PORT=8081
UNIFIED_API_PORT=8101
FORM_UI_PORT=8201
# Processing
POLL_SECONDS=3
BATCH_QUIET_SECONDS=30
# Email — MODO DE ENVÍO (postfix | custom). Global: TODO por Postfix local.
MAIL_SEND_MODE=postfix
SMTP_HOST=172.18.0.1
SMTP_PORT=25
SMTP_USER=
SMTP_PASS=
MAIL_FROM=procesos@codeengtools.eu
# Cuenta dedicada (custom) — SOLO la usa el form documento-transporte.
# Sin app password todavía: DÉJALO COMENTADO -> el form envía por Postfix con
# From=almacenalgeciras@totallogistic.es (lo fija tools.yaml: mail_from:).
# Cuando tengas la app password: descomenta las 4 líneas -> pasa a Gmail dedicado.
#SMTP_CUSTOM_HOST=smtp.gmail.com
#SMTP_CUSTOM_PORT=587
#SMTP_CUSTOM_USER=almacenalgeciras@totallogistic.es
#SMTP_CUSTOM_PASS=
MAIL_TO=noneedtoknow369@proton.me,mapinoma@gmail.com
# Per-tool
MAIL_TO_LEAR_CABLE=noneedtoknow369@proton.me
MAIL_TO_LEAR_RABAT=noneedtoknow369@proton.me
MAIL_TO_LEAR_TAC=noneedtoknow369@proton.me
MAIL_TO_LEAR_KENITRA=noneedtoknow369@proton.me
MAIL_TO_HOJA_CONTROL_EXPEDIENTES=noneedtoknow369@proton.me
MAIL_TO_INTRASTAT=noneedtoknow369@proton.me
MAIL_TO_CARATULA_DHL=noneedtoknow369@proton.me
MAIL_TO_MERGE_PDF=noneedtoknow369@proton.me
MAIL_INTERNO_MERGE_PDF=noneedtoknow369@proton.me
# Per-form
MAIL_TO_REGISTRO_VISITAS=noneedtoknow369@proton.me
MAIL_TO_MANTENIMIENTO_MAQUINAS=noneedtoknow369@proton.me
MAIL_TO_REVISION_ESTANTERIAS=noneedtoknow369@proton.me
MAIL_TO_REVISION_MOTOCICLETAS=noneedtoknow369@proton.me
MAIL_TO_REVISION_VEHICULOS=noneedtoknow369@proton.me
# Logging
LOG_LEVEL=INFO
PRECINTOS_PIN=123456
# en .env.prod (usa la IP del host, no localhost, para que el móvil llegue)
DECA_S3_ENDPOINT=http://192.168.0.58:9000
DECA_S3_BUCKET=deca-prod
DECA_S3_KEY=decatest
DECA_S3_SECRET=decatest123
DECA_PUBLIC_BASEURL=http://192.168.0.58:9000/deca-prod
# DeCA — almacenamiento propio (metadatos SQLite + copia de retención >=1 año)
# CREA LA CARPETA ANTES DE REINICIAR:  mkdir -p /data/ias_prod/data/deca
DECA_DB=/data/ias_prod/data/deca/deca.db
DECA_RETENTION_DIR=/data/ias_prod/data/deca/retencion