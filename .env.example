# ============================================
# Environment Configuration Template
# ============================================
# This is a template file. Copy it to create your environment-specific files:
#   cp .env.example env/myenv.env
#
# For multi-stack deployments on the same host, create separate env files
# for each environment (e.g., env/dev.env, env/staging.env, env/prod.env)
#
# Deploy with:
#   docker compose --env-file env/common.env --env-file env/myenv.env up -d

# --- Stack Identification ---
# Unique project name for this stack (required for running multiple stacks)
COMPOSE_PROJECT_NAME=ias_dev

# Root directory for all stack data
# All volumes will be created under this path: data/, sftpgo/, sftpgo_var/
STACK_ROOT=/data/ias_dev

# --- Ports (must be unique per stack on the same host) ---
# SFTP service port (external:internal)
SFTP_PORT=2224

# SFTPGo web admin UI port
SFTPGO_WEB_PORT=8084

# Tools/API web interface port
TOOLS_WEB_PORT=8085

# --- SMTP / Email (see env/common.env for shared settings) ---
# Override these only if this environment needs different SMTP settings
# EMAIL_MODE=BATCH_ONLY
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=YOUR_USER
# SMTP_PASS=YOUR_APP_PASSWORD
# MAIL_FROM=sender@domain.com
# MAIL_TO=recipient@domain.com

# --- Watcher / Processor (see env/common.env for shared settings) ---
# Override these only if this environment needs different behavior
# DONE_MARKER=_DONE
# POLL_SECONDS=3
# BATCH_QUIET_SECONDS=30

# --- SFTPGo bootstrap admin (only for first-time setup) ---
# SFTPGO_DEFAULT_ADMIN_USERNAME=admin
# SFTPGO_DEFAULT_ADMIN_PASSWORD=CHANGE_ME

# --- Optional Overrides ---
# Custom web site directory (if different from default)
# WEB_SITE_DIR=./services/web/site

# Maximum ZIP file size for uploads (in MB)
# MAX_ZIP_MB=200

