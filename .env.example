# Invoice Automation Suite - Environment Configuration

# Data storage
DATA_ROOT=/data

# Web configuration
TOOLS_WEB_PORT=8081

# Processing
POLL_SECONDS=3
BATCH_QUIET_SECONDS=30

# Email Configuration (Required)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASS=your-password
MAIL_FROM=noreply@company.com
MAIL_TO=recipient@company.com

# Logging
LOG_LEVEL=INFO
