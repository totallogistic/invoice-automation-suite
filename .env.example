# =============================================================================
# CONFIGURACIÓN DE INVOICE AUTOMATION SUITE
# =============================================================================
# Este archivo contiene todas las variables de entorno necesarias para el stack
# 
# INSTRUCCIONES:
# 1. Copia este archivo: cp .env.example .env
# 2. Edita .env con tus valores reales
# 3. NUNCA commitees el archivo .env (ya está en .gitignore)
#
# =============================================================================

# --- SMTP / Email Configuration ---
# Configuración para el envío de emails con los resultados procesados
EMAIL_MODE=BATCH_ONLY                    # Modo de envío (BATCH_ONLY para enviar al finalizar cada lote)

# Para Gmail:
# - Activa verificación en 2 pasos: https://myaccount.google.com/security
# - Crea App Password: https://myaccount.google.com/apppasswords
# - Usa la App Password en SMTP_PASS (no tu contraseña normal)
SMTP_HOST=smtp.gmail.com                 # Servidor SMTP (Gmail: smtp.gmail.com, Office365: smtp.office365.com)
SMTP_PORT=587                            # Puerto SMTP (587 para TLS, 465 para SSL)
SMTP_USER=YOUR_USER@gmail.com            # Usuario SMTP / Email del remitente
SMTP_PASS=YOUR_APP_PASSWORD              # Contraseña SMTP o App Password
MAIL_FROM=sender@domain.com              # Email del remitente (puede ser igual a SMTP_USER)
MAIL_TO=recipient@domain.com             # Email(s) destinatarios (separar múltiples con comas: user1@domain.com,user2@domain.com)

# --- Watcher / Processor Configuration ---
# Configuración del servicio que procesa los lotes
DONE_MARKER=_DONE                        # Marcador de archivo para indicar que un lote SFTP está completo
POLL_SECONDS=3                           # Frecuencia de verificación de nuevos lotes (en segundos)
BATCH_QUIET_SECONDS=300                  # Tiempo de inactividad para considerar un lote completo (5 minutos = 300 seg)

# --- SFTPGo Admin Bootstrap ---
# Credenciales del administrador de SFTPGo (solo se usan en la primera inicialización)
# ⚠️ IMPORTANTE: Cambia estos valores por seguridad
SFTPGO_DEFAULT_ADMIN_USERNAME=admin                    # Usuario administrador de SFTPGo
SFTPGO_DEFAULT_ADMIN_PASSWORD=INSECURE_CHANGE_THIS_NOW  # ⚠️ INSEGURO! CAMBIAR INMEDIATAMENTE por contraseña fuerte

# --- Paths y Directorios ---
# Directorios donde se almacenan los datos persistentes
# Por defecto: /data/ias_prod (producción)
# Para múltiples entornos, usa diferentes STACK_ROOT (ej: /data/ias_pre para pre-producción)
STACK_ROOT=/data/ias_prod                # Directorio raíz del stack
DATA_ROOT=/data/ias_prod/data            # Directorio de datos de procesamiento
SFTPGO_ROOT=/data/ias_prod/sftpgo        # Directorio de configuración SFTPGo
SFTPGO_VAR=/data/ias_prod/sftpgo_var     # Directorio de datos variables de SFTPGo

# --- Puertos Expuestos ---
# Ajusta si hay conflictos con otros servicios
SFTP_PORT=2222                           # Puerto para acceso SFTP (default: 2222)
SFTPGO_WEB_PORT=8080                     # Puerto para interfaz web de SFTPGo (default: 8080)
TOOLS_WEB_PORT=8081                      # Puerto para la UI web principal (default: 8081)

# --- Configuración del Servicio ---
MAX_ZIP_MB=200                           # Tamaño máximo de ZIP permitido (en MB)

# --- Docker Compose ---
COMPOSE_PROJECT_NAME=ias_prod            # Nombre del proyecto Docker Compose (útil para múltiples entornos)
