# --- SMTP / Email ---
EMAIL_MODE=BATCH_ONLY
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=YOUR_USER
SMTP_PASS=YOUR_APP_PASSWORD
MAIL_FROM=sender@domain.com
MAIL_TO=recipient@domain.com

# --- Watcher ---
DONE_MARKER=_DONE
POLL_SECONDS=3
BATCH_QUIET_SECONDS=300

# --- SFTPGo bootstrap admin (solo para primera vez) ---
SFTPGO_DEFAULT_ADMIN_USERNAME=admin
SFTPGO_DEFAULT_ADMIN_PASSWORD=CHANGE_ME
