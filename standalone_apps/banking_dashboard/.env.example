# Enable Banking credentials
# Get these from https://enablebanking.com/developers
ENABLE_BANKING_APP_ID=your-app-id-here
ENABLE_BANKING_KEY_PATH=/path/to/banking_dashboard/keys/private.pem

# Callback URL — must match what you register on Enable Banking dashboard
# Example: https://yourdomain.com/callback  or  http://localhost:8080/callback
APP_BASE_URL=http://localhost:8080

# Daily sync time (hour in 24h format, default 7 = 07:00)
SYNC_HOUR=7

# Email report recipient (uses iasuite_common.email)
REPORT_EMAIL=tu@email.com

# Uvicorn
PORT=8080
HOST=0.0.0.0
