[Unit]
Description=Banking Dashboard (uvicorn)
After=network.target

[Service]
Type=simple
User={{USER}}
WorkingDirectory={{APP_DIR}}
EnvironmentFile={{APP_DIR}}/.env
ExecStart={{APP_DIR}}/.venv/bin/uvicorn app:app --host 0.0.0.0 --port {{PORT}}
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
