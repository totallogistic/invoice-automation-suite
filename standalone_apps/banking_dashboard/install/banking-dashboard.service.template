[Unit]
Description=Banking Dashboard
After=network.target

[Service]
Type=simple
User={{USER}}
WorkingDirectory={{INSTALL_DIR}}/standalone_apps/banking_dashboard
EnvironmentFile={{INSTALL_DIR}}/standalone_apps/banking_dashboard/.env
ExecStart={{VENV}}/bin/uvicorn app:app --host 0.0.0.0 --port {{PORT}}
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
