# ── DeCA · configuración ──────────────────────────────────────────────────────
# Sin credenciales S3 → modo LOCAL (guarda en disco, sirve por la ruta /d de la API).
# Con credenciales S3 → PUT saliente al bucket (Hetzner Object Storage u otro).

# Endpoint del bucket S3-compatible (Hetzner: https://<region>.your-objectstorage.com)
DECA_S3_ENDPOINT=
DECA_S3_BUCKET=deca-prod
DECA_S3_KEY=
DECA_S3_SECRET=

# URL pública base. Por defecto = endpoint nativo del bucket (TLS válido del
# proveedor, sin tocar el DNS propio). Ej. Hetzner (virtual-hosted):
#   https://deca-prod.fsn1.your-objectstorage.com
DECA_PUBLIC_BASEURL=

# Ventana de la URL pública (días tras fin de servicio) y retención interna.
DECA_URL_TTL_DAYS=7
DECA_RETENTION_DIR=_deca_retencion

# Solo modo local (dev)
DECA_LOCAL_STORE=_deca_store
DECA_DB=deca.db
