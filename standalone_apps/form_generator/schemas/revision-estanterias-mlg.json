{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Revisión de Estanterías",
  "description": "Registro de revisión trimestral de estanterías - Delegación Málaga",
  "category": "📊 Sede Málaga",
  "custom_template": "estanterias-custom-mlg.html",
  "type": "object",
  "properties": {
    "fechaRevision": {"type": "string", "format": "date", "title": "Fecha de Revisión"},
    "responsable": {"type": "string", "title": "Responsable de la Comprobación"},
    "nave": {"type": "string", "title": "Nave / Zona"},
    "fila": {"type": "string", "title": "Fila de Estantería"},
    "trimestre": {"type": "string", "title": "Trimestre"},
    "colocacion": {"type": "string", "title": "Colocación"},
    "accesibilidadSenalizacion": {"type": "string", "title": "Accesibilidad y Señalización"},
    "corrosionPatas": {"type": "string", "title": "Corrosión en Patas"},
    "anclajesSuelo": {"type": "string", "title": "Anclajes al Suelo"},
    "proteccionesGolpes": {"type": "string", "title": "Protecciones Contra Golpes"},
    "observaciones": {"type": "string", "title": "Observaciones"}
  },
  "required": ["fechaRevision", "responsable", "nave", "fila", "trimestre"]
}
