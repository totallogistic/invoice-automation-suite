{
  "form_id": "mantenimiento-maquinas",
  "title": "Mantenimiento de Maquinaria de Almacén",
  "description": "Registro mensual de mantenimiento de máquinas - Delegación Algeciras",
  "excel_file": "mantenimiento-maquinas.xlsx",
  "custom_template": "mantenimiento-maquinas.html",
  "metadata": {
    "responsable": "DIEGO LADRÓN FONCUBIERTA",
    "delegacion": "Algeciras",
    "maquinas": [
      {
        "nombre": "CARRETILLA TOYOTA",
        "modelo": "7FBMF25",
        "revisiones": ["NIVELES BATERIAS", "ENGRASE"]
      },
      {
        "nombre": "CARRETILLA LATERAL STILL",
        "modelo": "FM 14",
        "revisiones": ["NIVELES BATERIAS", "ENGRASE"]
      },
      {
        "nombre": "TRASPALETA ELECTRICA - A",
        "modelo": "7PML20/6",
        "revisiones": ["NIVELES BATERIAS", "ENGRASE"]
      },
      {
        "nombre": "TRASPALETA ELECTRICA – C",
        "modelo": "LPE200",
        "revisiones": ["NIVELES BATERIAS", "ENGRASE"]
      },
      {
        "nombre": "RETRACTILADORA ELECT.",
        "modelo": "MA 00",
        "revisiones": ["ENGRASE", "FECHA REVISIÓN"]
      }
    ]
  },
  "fields": [
    {
      "name": "mes",
      "label": "Mes",
      "type": "select",
      "required": true,
      "options": [
        "ENERO",
        "FEBRERO",
        "MARZO",
        "ABRIL",
        "MAYO",
        "JUNIO",
        "JULIO",
        "AGOSTO",
        "SEPTIEMBRE",
        "OCTUBRE",
        "NOVIEMBRE",
        "DICIEMBRE"
      ]
    },
    {
      "name": "año",
      "label": "Año",
      "type": "number",
      "required": true,
      "default": "current_year"
    },
    {
      "name": "fecha_revision",
      "label": "Fecha de revisión",
      "type": "date",
      "required": true,
      "default": "today"
    },
    {
      "name": "responsable",
      "label": "Responsable",
      "type": "text",
      "required": true,
      "default": "DIEGO LADRÓN FONCUBIERTA"
    }
  ],
  "submit_button": "Guardar mantenimiento mensual",
  "success_message": "Mantenimiento registrado correctamente"
}
