{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/orden-compra-schema.json",
  "title": "Orden de Compra",
  "description": "Formulario simple para generar una orden de compra",
  "type": "object",
  "properties": {
    "numeroOrden": {
      "type": "string",
      "title": "Número de Orden",
      "description": "Número único de la orden de compra"
    },
    "fecha": {
      "type": "string",
      "format": "date",
      "title": "Fecha de Emisión"
    },
    "proveedor": {
      "type": "object",
      "title": "Datos del Proveedor",
      "properties": {
        "nombre": {
          "type": "string",
          "title": "Nombre del Proveedor"
        },
        "email": {
          "type": "string",
          "title": "Email",
          "format": "email"
        },
        "telefono": {
          "type": "string",
          "title": "Teléfono"
        }
      },
      "required": ["nombre", "email"]
    },
    "producto": {
      "type": "string",
      "title": "Producto o Servicio",
      "description": "Descripción del producto o servicio a adquirir"
    },
    "cantidad": {
      "type": "integer",
      "title": "Cantidad",
      "minimum": 1
    },
    "precioUnitario": {
      "type": "number",
      "title": "Precio Unitario (€)",
      "minimum": 0
    },
    "urgencia": {
      "type": "string",
      "title": "Nivel de Urgencia",
      "enum": ["Baja", "Normal", "Alta", "Urgente"]
    },
    "entregaDomicilio": {
      "type": "boolean",
      "title": "¿Entrega a domicilio?"
    },
    "observaciones": {
      "type": "string",
      "title": "Observaciones"
    }
  },
  "required": ["numeroOrden", "fecha", "proveedor", "producto", "cantidad", "precioUnitario"]
}