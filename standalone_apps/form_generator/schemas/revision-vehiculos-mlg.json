{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Revisión Vehículos",
  "description": "Formulario de revisión de los vehículos propiedad de la empresa - Málaga",
  "category": "📊 Sede Málaga",
  "custom_template": "revision-vehiculos-mlg.html",
  "type": "object",
  "properties": {
    "fecha": {"type": "string", "format": "date", "title": "Fecha de Revisión"},
    "responsable": {
      "type": "string",
      "enum": ["ANTONIO RODRIGUEZ SANTANA", "MANUEL RODRIGUEZ SANTANA"],
      "title": "Responsable"
    },
    "vehiculo": {
      "type": "string",
      "enum": ["JUMPER 5516 GDV"],
      "title": "Vehículo"
    },
    "kilometraje": {"type": "number", "title": "Kilometraje Actual"},
    "nivelAceite": {"type": "string", "enum": ["✓", "X"], "title": "Nivel de Aceite Correcto"},
    "nivelLiquidoFrenos": {"type": "string", "enum": ["✓", "X"], "title": "Nivel de Líquido de Frenos"},
    "nivelRefrigerante": {"type": "string", "enum": ["✓", "X"], "title": "Nivel de Refrigerante"},
    "presionNeumaticos": {"type": "string", "enum": ["✓", "X"], "title": "Presión de Neumáticos"},
    "lucesExteriores": {"type": "string", "enum": ["✓", "X"], "title": "Luces Exteriores Funcionando"},
    "limpiaparabrisas": {"type": "string", "enum": ["✓", "X"], "title": "Limpiaparabrisas Funcionando"},
    "estadoCarroceria": {
      "type": "string",
      "enum": ["Excelente", "Bueno", "Regular", "Necesita reparación"],
      "title": "Estado de Carrocería"
    },
    "observaciones": {"type": "string", "title": "Observaciones"}
  },
  "required": ["fecha", "responsable", "vehiculo", "kilometraje"]
}
