{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EU Customs Clearance Dossier (flat v1)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "shipment_reference",
    "shipment_incoterm",
    "shipment_transport_mode",
    "shipment_destination_member_state",
    "importer_name",
    "importer_established_in_eu",
    "customs_procedure"
  ],
  "properties": {
    "shipment_reference": { "type": "string", "minLength": 3, "maxLength": 60 },
    "shipment_incoterm": {
      "type": "string",
      "enum": ["EXW", "FCA", "CPT", "CIP", "DAP", "DPU", "DDP", "FAS", "FOB", "CFR", "CIF"]
    },
    "shipment_transport_mode": {
      "type": "string",
      "enum": ["maritime_container", "maritime_bulk", "short_sea", "air_short", "air_long", "road", "rail", "multimodal"]
    },
    "shipment_destination_member_state": {
      "type": "string",
      "pattern": "^[A-Z]{2}$",
      "description": "EU Member State ISO alpha-2, e.g., ES, FR, DE."
    },
    "shipment_first_entry_customs_office": { "type": "string", "minLength": 2, "maxLength": 80 },
    "shipment_arrival_date_iso": { "type": "string", "format": "date" },
    "shipment_goods_description": { "type": "string", "minLength": 3, "maxLength": 500 },
    "shipment_hs_code": { "type": "string", "pattern": "^[0-9]{6,10}$" },
    "shipment_value_amount": { "type": "number", "minimum": 0 },
    "shipment_value_currency": { "type": "string", "pattern": "^[A-Z]{3}$", "default": "EUR" },
    "shipment_country_of_origin": { "type": "string", "pattern": "^[A-Z]{2}$" },

    "importer_name": { "type": "string", "minLength": 2, "maxLength": 120 },
    "importer_established_in_eu": { "type": "boolean" },
    "importer_eori_number": { "type": "string", "minLength": 6, "maxLength": 35 },
    "importer_vat_number": { "type": "string", "minLength": 6, "maxLength": 20 },
    "importer_contact_email": { "type": "string", "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$" },

    "customs_procedure": {
      "type": "string",
      "enum": [
        "release_for_free_circulation",
        "transit_external",
        "transit_internal",
        "free_zone",
        "inward_processing",
        "outward_processing",
        "temporary_storage",
        "reexport"
      ]
    },
    "customs_dua_required": { "type": "boolean", "default": true },
    "customs_ens_required": { "type": "boolean", "default": false },
    "customs_preferential_origin_claim": { "type": "boolean", "default": false },

    "documents_proof_of_origin_type": {
      "type": "string",
      "enum": ["none", "non_preferential_certificate", "preferential_certificate", "invoice_declaration", "rex_statement"],
      "default": "none"
    },
    "documents_proof_of_origin_certificate_form": {
      "type": "string",
      "enum": ["form_a", "eur1", "eur_med", "other"]
    },
    "documents_proof_of_origin_exporter_authorised": { "type": "boolean", "default": false },
    "documents_proof_of_origin_reference_id": { "type": "string", "minLength": 1, "maxLength": 80 },

    "documents_commercial_invoice_present": { "type": "boolean", "default": true },
    "documents_packing_list_present": { "type": "boolean", "default": true },
    "documents_transport_document_type": {
      "type": "string",
      "enum": ["bill_of_lading", "air_waybill", "cmr", "rail_consignment_note", "other"]
    },

    "notes": { "type": "string", "maxLength": 2000 }
  }
}
