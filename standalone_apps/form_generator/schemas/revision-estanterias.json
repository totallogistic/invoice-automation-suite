{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Revisión de Estanterías",
  "description": "Registro de revisión trimestral de estanterías - Delegación Algeciras",
  "type": "object",
  "properties": {
    "fechaRevision": {
      "type": "string",
      "format": "date",
      "title": "Fecha de Revisión"
    },
    "responsable": {
      "type": "string",
      "title": "Responsable de la Comprobación",
      "enum": [
        "DIEGO LADRON FONCUBIERTA",
        "ASRIH EL KADDOURI HICHAM",
        "BECERRA SORIANO LUCAS MANUEL",
        "RODRIGUEZ SANTANA ANTONIO",
        "RODRIGUEZ SANTANA MANUEL"
      ]
    },
    "nave": {
      "type": "string",
      "title": "Nave / Zona",
      "enum": [
        "NAVE 1",
        "NAVE 2",
        "NAVE 3",
        "NAVE 4"
      ]
    },
    "fila": {
      "type": "string",
      "title": "Fila de Estantería",
      "enum": [
        "FILA 1", "FILA 2", "FILA 3", "FILA 4", "FILA 5",
        "FILA 6", "FILA 7", "FILA 8", "FILA 9", "FILA 10",
        "FILA 11", "FILA 12", "FILA 13", "FILA 14", "FILA 15",
        "FILA 16", "FILA 17"
      ]
    },
    "trimestre": {
      "type": "string",
      "title": "Trimestre",
      "enum": [
        "1er trimestre",
        "2do trimestre",
        "3er trimestre",
        "4to trimestre"
      ]
    },
    "colocacion": {
      "type": "string",
      "title": "Colocación",
      "enum": ["CORRECTO (√)", "INCORRECTO (X)"],
      "default": "CORRECTO (√)"
    },
    "accesibilidadSenalizacion": {
      "type": "string",
      "title": "Accesibilidad y Señalización",
      "enum": ["CORRECTO (√)", "INCORRECTO (X)"],
      "default": "CORRECTO (√)"
    },
    "corrosionPatas": {
      "type": "string",
      "title": "Corrosión en Patas",
      "enum": ["SIN CORROSIÓN (√)", "CON CORROSIÓN (X)"],
      "default": "SIN CORROSIÓN (√)"
    },
    "anclajesSuelo": {
      "type": "string",
      "title": "Anclajes al Suelo",
      "enum": ["CORRECTO (√)", "INCORRECTO (X)"],
      "default": "CORRECTO (√)"
    },
    "proteccionesGolpes": {
      "type": "string",
      "title": "Protecciones Contra Golpes",
      "enum": ["CORRECTO (√)", "INCORRECTO (X)"],
      "default": "CORRECTO (√)"
    },
    "observaciones": {
      "type": "string",
      "title": "Observaciones",
      "description": "Detalles adicionales o incidencias detectadas"
    }
  },
  "required": [
    "fechaRevision",
    "responsable",
    "nave",
    "fila",
    "trimestre",
    "colocacion",
    "accesibilidadSenalizacion",
    "corrosionPatas",
    "anclajesSuelo",
    "proteccionesGolpes"
  ]
}
