{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Revisión Vehículos",
  "description": "Formulario de revisión de los vehículos propiedad de la empresa",
  "type": "object",
  "properties": {
    "trabajador": {
      "type": "string",
      "title": "Trabajador",
      "enum": [
        "ASRIH EL KADDOURI HICHAM",
        "BECERRA SORIANO LUCAS MANUEL",
        "RODRIGUEZ SANTANA ANTONIO",
        "RODRIGUEZ SANTANA MANUEL"
      ]
    },
    "vehiculo": {
      "type": "string",
      "title": "Vehículo",
      "enum": [
        "HONDA PCX 4235 KKW",
        "HONDA PCX 3024 HFG",
        "JUMPER 1834 FZY ALGECIRAS",
        "JUMPER 5516GDV MALAGA",
        "Opción 5"
      ]
    },
    "kilometros": {
      "type": "integer",
      "title": "Kilómetros",
      "minimum": 0
    },
    "nivelAceite": {
      "type": "string",
      "title": "Nivel de Aceite",
      "enum": ["CORRECTO", "INCORRECTO"]
    },
    "nivelLiquidoRefrigerante": {
      "type": "string",
      "title": "Nivel de Líquido Refrigerante",
      "enum": ["CORRECTO", "INCORRECTO"]
    },
    "presionNeumaticos": {
      "type": "string",
      "title": "Presión de Neumáticos",
      "enum": ["CORRECTO", "INCORRECTO"]
    },
    "aspectoNeumaticos": {
      "type": "string",
      "title": "Aspecto Neumáticos",
      "enum": ["CORRECTO", "PRESENTA DESPERFECTOS"]
    },
    "lucesIntermitentes": {
      "type": "string",
      "title": "Luces Intermitentes",
      "enum": ["CORRECTO", "INCORRECTO"]
    },
    "eficaciaFrenado": {
      "type": "string",
      "title": "Eficacia de Frenado",
      "enum": ["CORRECTA", "INCORRECTA"]
    },
    "seHaAvisadoResponsable": {
      "type": "string",
      "title": "Se ha Avisado al Responsable",
      "enum": ["SI", "NO"]
    },
    "estadoLimpieza": {
      "type": "string",
      "title": "Estado de Limpieza",
      "enum": ["CORRECTO", "INCORRECTO LIMPIAR"]
    },
    "estadoGeneralVehiculo": {
      "type": "string",
      "title": "Estado General del Vehículo",
      "enum": ["CORRECTO", "INCORRECTO"]
    },
    "observaciones": {
      "type": "string",
      "title": "Observaciones",
      "description": "Comentarios adicionales sobre la revisión"
    }
  },
  "required": [
    "trabajador",
    "vehiculo",
    "kilometros",
    "nivelAceite",
    "nivelLiquidoRefrigerante",
    "presionNeumaticos",
    "aspectoNeumaticos",
    "lucesIntermitentes",
    "eficaciaFrenado",
    "seHaAvisadoResponsable",
    "estadoLimpieza",
    "estadoGeneralVehiculo"
  ]
}
