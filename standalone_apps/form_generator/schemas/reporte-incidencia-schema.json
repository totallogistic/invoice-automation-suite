{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/reporte-incidencia-schema.json",
  "title": "Reporte de Incidencia",
  "description": "Formulario para reportar incidencias operativas",
  "type": "object",
  "properties": {
    "numeroTicket": {
      "type": "string",
      "title": "Número de Ticket",
      "description": "Generado automáticamente o asignado manualmente"
    },
    "fechaHora": {
      "type": "string",
      "format": "date",
      "title": "Fecha de la Incidencia"
    },
    "reportadoPor": {
      "type": "string",
      "title": "Reportado Por"
    },
    "area": {
      "type": "string",
      "title": "Área Afectada",
      "enum": ["Almacén", "Transporte", "IT", "Administración", "Otro"]
    },
    "severidad": {
      "type": "string",
      "title": "Severidad",
      "enum": ["Baja", "Media", "Alta", "Crítica"]
    },
    "tituloIncidencia": {
      "type": "string",
      "title": "Título de la Incidencia"
    },
    "descripcion": {
      "type": "string",
      "title": "Descripción Detallada"
    },
    "accionInmediata": {
      "type": "string",
      "title": "Acción Inmediata Tomada (opcional)"
    },
    "requiereAtencionUrgente": {
      "type": "boolean",
      "title": "¿Requiere atención urgente?"
    }
  },
  "required": ["numeroTicket", "fechaHora", "reportadoPor", "area", "severidad", "tituloIncidencia", "descripcion"]
}