{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Revisión de Motocicletas",
  "description": "Registro de revisiones y mantenimiento de motocicletas de empresa",
  "type": "object",
  "properties": {
    "fechaRevision": {
      "type": "string",
      "format": "date",
      "title": "Fecha de Revisión"
    },
    "motocicleta": {
      "type": "string",
      "title": "Motocicleta",
      "enum": [
        "HONDA PCX 4235 KKW",
        "HONDA PCX 3024 HFG"
      ]
    },
    "kilometros": {
      "type": "integer",
      "title": "Kilómetros",
      "minimum": 0
    },
    "tipoRevision": {
      "type": "string",
      "title": "Tipo de Revisión",
      "enum": [
        "Mantenimiento (M)",
        "Lavado y Batería (LB)",
        "Homologación (H)",
        "Revisión General",
        "Cambio de Aceite",
        "Revisión de Neumáticos",
        "Revisión de Frenos"
      ]
    },
    "responsable": {
      "type": "string",
      "title": "Responsable / Conductor",
      "enum": [
        "ASRIH EL KADDOURI HICHAM",
        "BECERRA SORIANO LUCAS MANUEL",
        "RODRIGUEZ SANTANA ANTONIO",
        "RODRIGUEZ SANTANA MANUEL"
      ]
    },
    "nivelAceite": {
      "type": "string",
      "title": "Nivel de Aceite",
      "enum": ["CORRECTO", "BAJO", "CAMBIO REALIZADO", "N/A"]
    },
    "nivelLiquidoRefrigerante": {
      "type": "string",
      "title": "Nivel de Líquido Refrigerante",
      "enum": ["CORRECTO", "BAJO", "N/A"]
    },
    "estadoNeumaticos": {
      "type": "string",
      "title": "Estado de Neumáticos",
      "enum": ["BUEN ESTADO", "DESGASTE MEDIO", "REQUIERE CAMBIO", "CAMBIADOS"]
    },
    "presionNeumaticos": {
      "type": "string",
      "title": "Presión de Neumáticos",
      "enum": ["CORRECTA", "AJUSTADA", "INCORRECTA"]
    },
    "estadoFreno": {
      "type": "string",
      "title": "Estado de Frenos",
      "enum": ["CORRECTO", "DESGASTADOS", "REQUIERE CAMBIO"]
    },
    "lucesYSenalizacion": {
      "type": "string",
      "title": "Luces y Señalización",
      "enum": ["FUNCIONAN CORRECTAMENTE", "ALGUNA BOMBILLA FUNDIDA", "REPARADO"]
    },
    "estadoBateria": {
      "type": "string",
      "title": "Estado de Batería",
      "enum": ["CARGA CORRECTA", "CARGA BAJA", "REEMPLAZADA"]
    },
    "incidencias": {
      "type": "string",
      "title": "Incidencias / Problemas Detectados",
      "description": "Detalle de cualquier problema o anomalía encontrada"
    },
    "reparacionesRealizadas": {
      "type": "string",
      "title": "Reparaciones Realizadas",
      "description": "Trabajos de mantenimiento o reparación efectuados"
    },
    "proximaRevision": {
      "type": "string",
      "format": "date",
      "title": "Fecha de Próxima Revisión"
    },
    "proximosKilometros": {
      "type": "integer",
      "title": "Kilómetros para Próxima Revisión",
      "description": "Ejemplo: próximo cambio de aceite a los 5000 km"
    },
    "observaciones": {
      "type": "string",
      "title": "Observaciones Generales"
    }
  },
  "required": [
    "fechaRevision",
    "motocicleta",
    "kilometros",
    "tipoRevision",
    "responsable",
    "nivelAceite",
    "estadoNeumaticos",
    "presionNeumaticos",
    "estadoFreno",
    "lucesYSenalizacion",
    "estadoBateria"
  ]
}
