{
  "form_id": "registro-visitas",
  "title": "Registro de Visitas",
  "description": "Formulario de registro de visitas a las instalaciones",
  "excel_file": "registro-visitas.xlsx",
  "custom_template": "registro-visitas.html",
  "fields": [
    {
      "name": "fecha",
      "label": "Fecha",
      "type": "date",
      "required": true,
      "default": "today"
    },
    {
      "name": "nombre",
      "label": "Nombre",
      "type": "text",
      "required": true,
      "autocomplete": true,
      "autocomplete_source": "visitor_names"
    },
    {
      "name": "apellidos",
      "label": "Apellidos",
      "type": "text",
      "required": true,
      "autocomplete": true,
      "autocomplete_source": "visitor_surnames"
    },
    {
      "name": "dni",
      "label": "DNI/NIE",
      "type": "text",
      "required": true,
      "pattern": "^[0-9]{8}[A-Z]$|^[XYZ][0-9]{7}[A-Z]$",
      "autocomplete": true,
      "autocomplete_source": "visitor_dni"
    },
    {
      "name": "empresa",
      "label": "Empresa",
      "type": "text",
      "required": true
    },
    {
      "name": "motivo",
      "label": "Motivo de la visita",
      "type": "select",
      "required": true,
      "options": [
        "Reunión",
        "Auditoría",
        "Mantenimiento",
        "Proveedor",
        "Cliente",
        "Otro"
      ]
    },
    {
      "name": "persona_contacto",
      "label": "Persona de contacto",
      "type": "text",
      "required": true
    },
    {
      "name": "hora_entrada",
      "label": "Hora de entrada",
      "type": "time",
      "required": true,
      "default": "now"
    },
    {
      "name": "observaciones",
      "label": "Observaciones",
      "type": "textarea",
      "required": false,
      "rows": 3
    },
    {
      "name": "rgpd_consent",
      "label": "He leído y acepto la <a href='/politica-privacidad' target='_blank'>política de privacidad y tratamiento de datos personales</a>",
      "type": "checkbox",
      "required": true
    }
  ],
  "submit_button": "Registrar visita",
  "success_message": "Visita registrada correctamente"
}
