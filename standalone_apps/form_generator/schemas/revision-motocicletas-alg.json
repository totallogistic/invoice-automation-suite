{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Revisión de Motocicletas",
  "description": "Registro de revisiones y mantenimiento de motocicletas de empresa - Algeciras",
  "category": "📊 Sede Algeciras",
  "custom_template": "revision-motocicletas-alg.html",
  "type": "object",
  "properties": {
    "fecha": {
      "type": "string",
      "format": "date",
      "title": "Fecha"
    },
    "vehiculo": {
      "type": "string",
      "title": "Vehículo",
      "enum": [
        "HONDA PCX 4235 KKW",
        "HONDA PCX 3024 HFG"
      ]
    },
    "responsable": {
      "type": "string",
      "title": "Responsable",
      "enum": [
        "HICHAM ASRIH EL KADDOURI",
        "SAMUEL JESUS DAMAS DOMINGUEZ"
      ]
    },
    "kilometraje": {
      "type": "number",
      "title": "Kilometraje"
    },
    "aspectoLimpieza": {
      "type": "string",
      "enum": [
        "✓",
        "X"
      ],
      "title": "Aspecto General / Limpieza"
    },
    "revisionFrenos": {
      "type": "string",
      "enum": [
        "✓",
        "X"
      ],
      "title": "Revisión de Frenos"
    },
    "nivelAceite": {
      "type": "string",
      "enum": [
        "✓",
        "X"
      ],
      "title": "Nivel de Aceite"
    },
    "presionNeumaticos": {
      "type": "string",
      "enum": [
        "✓",
        "X"
      ],
      "title": "Presión de Neumáticos"
    },
    "luces": {
      "type": "string",
      "enum": [
        "✓",
        "X"
      ],
      "title": "Luces Funcionando"
    },
     "estadoGeneral": {
      "type": "string",
      "enum": [
        "✓",
        "X"
      ],
      "title": "Estado General"
    },
    "observaciones": {
      "type": "string",
      "title": "Observaciones"
    }
  },
  "required": [
    "fecha",
    "vehiculo",
    "responsable"
  ]
}