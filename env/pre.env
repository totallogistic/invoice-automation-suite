# ============================================
# PRE-PRODUCTION Environment Configuration
# ============================================
# This file contains ONLY environment-specific settings.
# Common settings are in env/common.env
#
# To deploy: docker compose --env-file env/common.env --env-file env/pre.env up -d

# --- Stack Identification ---
# Unique project name for this stack (used for container naming and isolation)
COMPOSE_PROJECT_NAME=ias_pre

# Root directory for all stack data (volumes will be created under this path)
STACK_ROOT=/data/ias_pre

# --- Ports (must be unique per stack on the same host) ---
# SFTP service port
SFTP_PORT=2223

# SFTPGo web admin UI port
SFTPGO_WEB_PORT=8083

# Tools/API web interface port
TOOLS_WEB_PORT=8082

# --- Environment-Specific Overrides (optional) ---
# Override watcher behavior for faster testing in pre-production
BATCH_QUIET_SECONDS=1

# Custom web site directory for pre-production
WEB_SITE_DIR=./services/web/site_pre

# Environment-specific email recipients (optional override)
# MAIL_TO=mapinoma@gmail.com,tls-lear@totallogistic.es
