# ============================================
# Common Configuration
# Shared across all environments (pre, prod, dev, etc.)
# ============================================

# --- SMTP / Email Configuration ---
# These settings are shared across all environments
SMTP_HOST=tlseng-es.correoseguro.dinaserver.com
SMTP_PORT=465
SMTP_USER=procesos@tlseng.es
SMTP_PASS=Machaco2$
MAIL_FROM=procesos@tlseng.es
EMAIL_MODE=BATCH_ONLY

# Default email recipients (can be overridden per environment)
MAIL_TO=mapinoma@gmail.com,tls-lear@totallogistic.es

# --- Watcher / Processor Behavior ---
# Marker file to indicate batch is complete
DONE_MARKER=_DONE

# How often to poll for new files (in seconds)
POLL_SECONDS=3

# How long to wait for inactivity before processing a batch (in seconds)
BATCH_QUIET_SECONDS=30

# --- API Configuration ---
# Maximum ZIP file size for uploads (in MB)
MAX_ZIP_MB=200
