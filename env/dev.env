# --- Compose identity ---
COMPOSE_PROJECT_NAME=ias_dev

# --- Persistent data (MUST be unique per env/stack) ---
STACK_ROOT=/data/ias_dev
DATA_ROOT=/data/ias_dev/data

# --- Web (nginx container) ---
TOOLS_WEB_PORT=8083
WEB_SITE_DIR=./services/web/site_dev

# --- (Optional) Batch processor tuning ---
DONE_MARKER=_DONE
POLL_SECONDS=3
BATCH_QUIET_SECONDS=1

# --- (Optional) Email mode + SMTP (leave empty if not used) ---
SMTP_HOST=tlseng-es.correoseguro.dinaserver.com
SMTP_PORT=465
MAIL_FROM=procesos@tlseng.es
SMTP_USER=procesos@tlseng.es
SMTP_PASS=Machaco2$
MAIL_TO=mapinoma@gmail.com
MAIL_FROM=procesos@tlseng.es
EMAIL_MODE=BATCH_ONLY

# --- (Optional) API limits ---
MAX_ZIP_MB=200

