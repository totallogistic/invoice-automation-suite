# ============================================
# PRODUCTION Environment Configuration
# ============================================
# This file contains ONLY environment-specific settings.
# Common settings are in env/common.env
#
# To deploy: docker compose --env-file env/common.env --env-file env/prod.env up -d

# --- Stack Identification ---
# Unique project name for this stack (used for container naming and isolation)
COMPOSE_PROJECT_NAME=ias_prod

# Root directory for all stack data (volumes will be created under this path)
STACK_ROOT=/data/ias_prod

# --- Ports (must be unique per stack on the same host) ---
# SFTP service port
SFTP_PORT=2222

# SFTPGo web admin UI port
SFTPGO_WEB_PORT=8080

# Tools/API web interface port
TOOLS_WEB_PORT=8081

# --- Environment-Specific Overrides (optional) ---
# Override watcher behavior for production (faster processing)
BATCH_QUIET_SECONDS=1

